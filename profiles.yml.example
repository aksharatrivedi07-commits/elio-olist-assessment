# copy this to ~/.dbt/profiles.yml and set the three environment variables.
# real credentials never go in the repo.
dbt_project:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      role: transformer
      warehouse: elio_wh
      database: olist
      schema: staging
      threads: 4